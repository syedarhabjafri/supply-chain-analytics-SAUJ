      "source": [
        "# Calculate Total PO Spend: Sum of 'PO Value (PKR)'\n",
        "total_po_spend = df['PO Value (PKR)'].sum()\n",
        "\n",
        "# Calculate Total Number of POs: Count unique 'PO Number' entries\n",
        "total_num_pos = df['PO Number'].nunique()\n",
        "\n",
        "# Calculate Total Number of Vendors: Count unique 'Vendor ID' entries\n",
        "total_num_vendors = df['Vendor ID'].nunique()\n",
        "\n",
        "# Calculate Average PO Value:\n",
        "# First, group by 'PO Number' to get the total value for each unique PO,\n",
        "# then calculate the mean of these total PO values.\n",
        "po_total_values = df.groupby('PO Number')['PO Value (PKR)'].sum()\n",
        "average_po_value = po_total_values.mean()\n",
        "\n",
        "# Calculate Average Line-Item Value: Mean of 'PO Value (PKR)'\n",
        "average_line_item_value = df['PO Value (PKR)'].mean()\n",
        "\n",
        "# Create a summary DataFrame for display\n",
        "metrics_summary = pd.DataFrame({\n",
        "    'Metric': [\n",
        "        'Total PO Spend (PKR)',\n",
        "        'Total Number of POs',\n",
