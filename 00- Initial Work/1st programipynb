      "source": [
        "# Ensure 'Quantity' is a numeric column for calculation\n",
        "# This step is already included in data cleaning, but good to ensure before aggregation\n",
        "if 'Quantity' in df.columns:\n",
        "    df['Quantity'] = pd.to_numeric(df['Quantity'], errors='coerce')\n",
        "    # Drop any rows where Quantity became NaN after coercion if they are critical\n",
        "    df.dropna(subset=['Quantity'], inplace=True)\n",
        "\n",
        "# Group by 'Vendor' and sum the 'Quantity' to find total volume per vendor\n",
        "vendor_volume = df.groupby('Vendor')['Quantity'].sum().reset_index()\n",
        "\n",
        "# Sort vendors by total volume in descending order and get the top 10\n",
        "top_10_vendors_by_volume = vendor_volume.sort_values(by='Quantity', ascending=False).head(10)\n",
        "\n",
        "# Display the top 10 vendors by volume\n",
        "print(\"\\nTop 10 Vendors by Order Quantity Volume:\")\n",
        "display(top_10_vendors_by_volume)"
