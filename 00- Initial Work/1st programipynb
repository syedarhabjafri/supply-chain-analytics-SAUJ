        "### Visualization: Pareto Analysis of Vendors by PO Value\n",
        "\n",
        "This visualization will combine a bar chart of individual vendor spend with a line chart showing the cumulative spend percentage, clearly indicating which vendors contribute to the majority of the total spend."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 497
        },
        "id": "731dce07",
        "outputId": "94e9562a-7be8-41aa-e7d0-d0087f30477a"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Create a combined plot for Pareto analysis\n",
        "fig, ax1 = plt.subplots(figsize=(14, 8))\n",
        "\n",
        "# Bar plot for individual vendor spend percentage\n",
        "sns.barplot(x='Vendor', y='Percentage of Total Spend', data=vendor_spend, ax=ax1, palette='viridis')\n",
        "ax1.set_xlabel('Vendor')\n",
        "ax1.set_ylabel('Percentage of Total Spend (%)', color='blue')\n",
        "ax1.tick_params(axis='y', labelcolor='blue')\n",
        "ax1.set_title('Pareto Analysis of Vendors by PO Value')\n",
        "ax1.set_xticklabels(vendor_spend['Vendor'], rotation=90, ha='right')\n",
        "\n",
        "# Create a second y-axis for cumulative percentage\n",
        "ax2 = ax1.twinx()\n",
        "sns.lineplot(x='Vendor', y='Cumulative Percentage', data=vendor_spend, ax=ax2, color='red', marker='o', sort=False)\n",
        "ax2.set_ylabel('Cumulative Percentage (%)', color='red')\n",
        "ax2.tick_params(axis='y', labelcolor='red')\n",
        "ax2.axhline(y=80, color='gray', linestyle='--', label='80% Threshold')\n",
        "ax2.legend(loc='upper left')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
