      "source": [
        "### Summary Table: ABC Analysis of Suppliers Overview\n",
        "\n",
        "This table provides a summary of each ABC category for suppliers, including the number of suppliers in each category, their total spend, and their cumulative percentage contribution."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 215
        },
        "id": "25225d61",
        "outputId": "db4660ec-936a-43cf-b8d2-29cc68580817"
      },
      "source": [
        "abc_supplier_summary = supplier_spend.groupby('ABC Category').agg(\n",
        "    Num_Suppliers=('Vendor', 'count'),\n",
        "    Total_PO_Value=('PO Value (PKR)', 'sum'),\n",
        "    Percentage_of_Total_Spend=('Percentage of Total Spend', 'sum')\n",
        ").reset_index()\n",
        "\n",
        "# Calculate cumulative percentage for the summary table as well\n",
        "abc_supplier_summary = abc_supplier_summary.sort_values(by='Percentage_of_Total_Spend', ascending=False)\n",
        "abc_supplier_summary['Cumulative Percentage'] = abc_supplier_summary['Percentage_of_Total_Spend'].cumsum()\n",
        "\n",
        "print(\"\\nFinal Summary Table: ABC Analysis of Suppliers Overview (Excluding Unknown Vendor)\")\n",
        "display(abc_supplier_summary.style.format({\n",
        "    'Total_PO_Value': '{:,.2f}',\n",
        "    'Percentage_of_Total_Spend': '{:.2f}%',\n",
        "    'Cumulative Percentage': '{:.2f}%'\n",
        "}))"
      ],
