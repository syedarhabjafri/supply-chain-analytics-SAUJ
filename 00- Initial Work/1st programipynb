      "source": [
        "# Check for missing values across all columns\n",
        "print(\"\\nMissing values before cleaning:\")\n",
        "display(df.isnull().sum())\n",
        "\n",
        "# Convert relevant columns to appropriate data types\n",
        "# Identify columns that look like dates and convert them\n",
        "date_cols = ['Creation Date', 'GR Date', 'Invoice Date'] # Using actual date columns from df.info()\n",
        "for col in date_cols:\n",
        "    if col in df.columns:\n",
        "        df[col] = pd.to_datetime(df[col], errors='coerce')\n",
        "\n",
        "# Identify columns that look like numerical values\n",
        "numeric_cols = ['Quantity', 'Unit Price (PKR)', 'PO Value (PKR)', 'GR Value (PKR)', 'Invoice Amount (PKR)', 'Paid Amount (PKR)', 'Outstanding Invoice (PKR)'] # Using actual numeric columns\n",
        "for col in numeric_cols:\n",
        "    if col in df.columns:\n",
        "        df[col] = pd.to_numeric(df[col], errors='coerce')\n",
        "\n",
        "# Drop rows where 'PO Value (PKR)' or 'Quantity' might be missing as they are crucial for spend analysis\n",
        "df.dropna(subset=['PO Value (PKR)', 'Quantity'], inplace=True)\n",
        "\n",
        "# Fill missing values for categorical columns with 'Unknown' if applicable\n",
        "categorical_cols_to_fill = ['Vendor', 'Material Group', 'Cost Center'] # Using actual categorical columns\n",
        "for col in categorical_cols_to_fill:\n",
        "    if col in df.columns:\n",
        "        df[col] = df[col].fillna('Unknown')\n",
        "\n",
        "# Add 'Total Cost' for consistency with previous analysis if 'Unit Price (PKR)' and 'Quantity' exist\n",
        "# If 'PO Value (PKR)' is intended as the 'Total Cost' for a line item, we can rename it or create a new column.\n",
