      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Create the bar chart for ABC Analysis of Suppliers\n",
        "plt.figure(figsize=(14, 8))\n",
        "sns.barplot(x='Percentage of Total Spend', y='Vendor', hue='ABC Category', data=supplier_spend, palette='viridis', dodge=False)\n",
        "plt.title('ABC Analysis of Suppliers by PO Value (PKR) (Excluding Unknown Vendor)')\n",
        "plt.xlabel('Percentage of Total Spend (%)')\n",
        "plt.ylabel('Supplier')\n",
        "plt.grid(axis='x', linestyle='--', alpha=0.7)\n",
        "plt.legend(title='ABC Category')\n",
        "plt.tight_layout()\n",
        "plt.show()"
