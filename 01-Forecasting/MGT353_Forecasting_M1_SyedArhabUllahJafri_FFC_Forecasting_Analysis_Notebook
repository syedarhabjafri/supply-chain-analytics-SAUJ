      "source": [
        "# %% [2] Naive and Seasonal Naive ---------------------------------------\n",
        "forecasts[\"Naive\"] = np.repeat(y_train[-1], H)                       # last observed week, held flat\n",
        "season = 52\n",
        "forecasts[\"Seasonal Naive\"] = y_train[len(y_train) - season : len(y_train) - season + H]  # same week last year (all in train)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "J1fgnwLloTH-"
      },
      "execution_count": 4,
      "outputs": [],
      "source": [
        "# %% [3] Simple Moving Average (4-week) ---------------------------------\n",
        "forecasts[\"Moving Average (4 wk)\"] = np.repeat(y_train[-4:].mean(), H)"
      ]
    },
    {
      "cell_type": "code",
